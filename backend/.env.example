# Rule #1 Screener - Environment Variables
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key for AI Analysis
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: EODHD API key for deep 10y fundamentals (hybrid provider)
# Get your key at: https://eodhd.com/
# Without it, deep analysis falls back to Yahoo Finance
EODHD_API_KEY=

# Optional: Database URL
# Default (recommended for local): SQLite at backend/.tmp/rule1.db
# For Postgres: postgresql://user:pass@localhost:5432/rule1_db
# Placeholder postgresql://user:password@localhost/... is ignored → SQLite
DATABASE_URL=

# Optional: Redis URL for caching (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# ── Automatic scanning (no manual UI click required) ──────────
# Start library + pattern scans when the backend boots (default: on)
AUTO_SCAN_ON_STARTUP=true
# Skip startup scan if both result caches are fresher than this many hours
AUTO_SCAN_STALE_HOURS=12
# Delay before the startup auto-scan begins (seconds)
AUTO_SCAN_STARTUP_DELAY_SEC=1
# Universe for auto-scans: "all" or e.g. "sp500"
AUTO_SCAN_UNIVERSE=all
# Majors scanned first so the UI fills quickly with real Yahoo data
AUTO_SCAN_FAST_UNIVERSE=sp500
AUTO_SCAN_PRIORITY=sp500,nasdaq100,dowjones,sp400,sp600
# Parallel Yahoo fetches (higher = faster, stay under Yahoo soft limits)
SCAN_CONCURRENCY=12
YAHOO_RATE_PER_SEC=12
YAHOO_BURST=24
# Nightly cron (UTC). Always refreshes (force), independent of stale hours.
SCANNER_CRON_HOUR=2
SCANNER_CRON_MINUTE=0

# Live quote cache TTL in seconds (default 20). Keep low for near-real-time UI.
QUOTE_CACHE_TTL=20
# Prefer Yahoo fast_info (last trade) when refreshing this many symbols or fewer.
QUOTE_FAST_INFO_LIMIT=40
# Market indices bar cache TTL in seconds
MARKET_INDICES_TTL=15
# Fundamentals bundle cache (hours-safe). Prices are overlaid separately.
BUNDLE_CACHE_TTL=43200
